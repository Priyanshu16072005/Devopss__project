# Copy to .env (same folder as docker-compose.yml) and change the values.
# docker compose reads this file automatically. Never commit the real .env.

# Docker Hub user used for image names
DOCKER_USER=priyanshu8948
TAG=latest

# Leave MONGODB_URI unset to use the local mongo container,
# or point it at MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/foodforall

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (empty = allow all)
CORS_ORIGIN=

# Password of the Nagios web interface (user: nagiosadmin)
NAGIOSADMIN_PASSWORD=change_me
