<%- | String $color | -%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Food For All | <%= $facts['networking']['hostname'] %></title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #1d2430; }
    header { background: <%= $color %>; color: #fff; padding: 24px; }
    main { max-width: 640px; margin: 24px auto; padding: 0 16px; }
  </style>
</head>
<body>
  <header>
    <h1>Food For All - <%= $facts['networking']['hostname'] %></h1>
    <p>Deployed by Puppet</p>
  </header>
  <main>
    <p>Host: <%= $facts['networking']['fqdn'] %></p>
    <p>IP address: <%= $facts['networking']['ip'] %></p>
    <p><a href="/">Open the Food For All app</a></p>
  </main>
</body>
</html>
